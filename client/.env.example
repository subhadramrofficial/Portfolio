# Copy to ".env" (local) or set in your hosting dashboard (production).
# Full URL of the backend API, including "/api". Placeholders only - no secrets belong here:
# anything in a VITE_* variable is public in the browser bundle.
#
# Local development: leave unset to use the Vite dev proxy ("/api" -> http://localhost:5000),
# or set explicitly:
VITE_API_URL=http://localhost:5000/api
#
# Production example:
# VITE_API_URL=https://your-api.onrender.com/api

# Copy to ".env" and fill in your own values. NEVER commit ".env".
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (see README: "MongoDB Atlas setup")
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/portfolio?retryWrites=true&w=majority

# Exact origin(s) of your frontend, comma-separated, no trailing slash.
# Production example: https://your-portfolio.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (Render/Railway/Heroku = 1). Local = 0.
TRUST_PROXY=0

# SMTP (see README: "SMTP / email setup"). Leave blank to run without email notifications;
# messages are still saved and visitors are told the notification could not be sent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="Portfolio Contact <no-reply@example.com>"
CONTACT_RECIPIENT_EMAIL=you@example.com
